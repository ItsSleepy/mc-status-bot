DISCORD_TOKEN=your-bot-token-here
CHANNEL_ID=your-channel-id
MC_HOST=localhost
MC_PORT=25565
UPDATE_INTERVAL_MINUTES=5
SERVER_LABEL=EUGH Server

# Modpack changelog (optional)
SERVER_DIR=/path/to/server
#MODS_DIR=/path/to/server/mods
#MODPACK_CHANNEL_ID=
#PACK_DOWNLOAD_URL=
MODPACK_CHECK_MINUTES=30
